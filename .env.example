DJANGO_PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/django.sqlite3
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# npm run dev explicitly enables development mode and generates a private local secret.
# Production requires a random secret, DJANGO_DEBUG=false, and HTTPS.
DJANGO_SECRET_KEY=
# Required when creating the first administrator in production.
SETUP_TOKEN=
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_SIZE=10485760
REDIS_URL=

# Set your provider's SMTP details. Never put real credentials in this file.
SMTP_HOST=
SMTP_ALLOWED_HOSTS=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=